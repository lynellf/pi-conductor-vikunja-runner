{
  "name": "pi-conductor-vikunja-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user daemon for running approved Vikunja coding tasks through pi-conductor.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format:check": "biome format .",
    "dev": "tsx src/cli/main.ts",
    "start": "node dist/cli/main.js",
    "runner:validate": "node dist/cli/main.js validate",
    "runner:once": "node dist/cli/main.js once",
    "runner:health": "node dist/cli/main.js health",
    "audit": "pnpm audit --prod"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.79.1",
    "@earendil-works/pi-tui": "0.79.1",
    "pi-conductor": "0.12.0",
    "pi-conductor-analytics-plugin": "0.2.0",
    "typebox": "1.1.38",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "22.15.21",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
